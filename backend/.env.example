MONGO_URI=your_mongodb_uri
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
JWT_SECRET=your_secret_here
URLSCAN_API_KEY=your_urlscan_api_key
URLSCAN_BASE_URL=https://urlscan.io
URLSCAN_VISIBILITY=unlisted
URLSCAN_INITIAL_WAIT_SECONDS=10
URLSCAN_POLL_INTERVAL_SECONDS=5
URLSCAN_MAX_POLL_ATTEMPTS=6
URLSCAN_SUBMIT_TIMEOUT_SECONDS=15
URLSCAN_RESULT_TIMEOUT_SECONDS=15
VIRUSTOTAL_TIMEOUT_SECONDS=8
OLLAMA_TIMEOUT_SECONDS=90
MONGO_TIMEOUT_MS=5000
URL_CACHE_TTL_HOURS=24
URL_ANALYSIS_MAX_WORKERS=3
